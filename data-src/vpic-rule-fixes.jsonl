{"id": "rf-013", "release": "2026_11", "case": "wrong_value", "errors": [{"pattern": "3VWSG71K*5M", "model_year": 2005, "make": "VOLKSWAGEN", "model": "Jetta", "field": "EngineCylinders", "vpic_value": "6", "correct_value": "5", "test_vehicles": 1}], "edits": [{"action": "modify", "table": "pattern", "row": {"id": 191406, "schema_id": 4291, "schema": "Volkswagen Schema for WVW/WVG/3VW/9BW - 2005", "keys": "*G*1K", "element": "EngineCylinders", "attribute_id": "6", "value": "6"}, "set": {"attribute_id": "5", "value": 5}}], "reason": "*G*1K is the 2005 Jetta 2.5 (vPIC's own displacement for it is 2480 cc), the five-cylinder; the row said 6. NHTSA's test Jetta had 5 cylinders and EPA lists only 5 for this model-year.", "evidence": [{"url": "https://nrd-static.nhtsa.dot.gov/reports/vehdb/v00000/v05300/v05374R014.pdf", "test_no": 5374}], "reviewed": {"on": "2026-11-18", "by": "mcp.vin decode audit 2026-11-17 (confirmed list); rule rows traced by the local decoder"}, "checks": [{"vin": "3VWSG71K55M606750", "fields": {"EngineCylinders": {"official_value": "6", "fixed_value": "5"}}}]}
