[Unit]
Description=mcp.vin: crawl NHTSA 5-Star Safety Ratings (current + next model years), build + publish
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=NHTSA_WORK=/srv/nhtsa-build
ExecStart=/opt/vin-mcp-builder/scripts/nhtsa-build.sh ratings
Nice=15
IOSchedulingClass=idle
MemoryMax=600M
TimeoutStartSec=14h
