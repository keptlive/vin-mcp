[Unit]
Description=mcp.vin: look for a new monthly vPIC release; build, parity-check + publish it
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=NHTSA_WORK=/srv/nhtsa-build
ExecStart=/opt/vin-mcp-builder/scripts/nhtsa-build.sh vpic
Nice=15
IOSchedulingClass=idle
MemoryMax=1800M
TimeoutStartSec=12h
