[Unit]
Description=mcp.vin: refresh local NHTSA recall and complaint data (scripts/nhtsa-refresh.sh flat)
Documentation=file:///opt/vin-mcp/docs/nhtsa-local-data.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/vin-mcp
ExecStart=/opt/vin-mcp/scripts/nhtsa-refresh.sh flat
StateDirectory=vin-mcp-nhtsa
Environment=NHTSA_WORK=/var/lib/vin-mcp-nhtsa
# A background job on the web server: lowest CPU and disk priority, bounded memory (the complaint build peaked at 720 MB).
Nice=15
IOSchedulingClass=idle
MemoryMax=1200M
TimeoutStartSec=4h
